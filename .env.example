# ── Groq ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Qdrant ───────────────────────────────────────────────
# Local: localhost + empty QDRANT_API_KEY. Cloud: hostname only (strip https:// from
# the cluster endpoint), plus QDRANT_API_KEY from Qdrant Cloud → API Keys (copy once).
# For scheduled GitHub workflow "Qdrant Keep-Alive", add repository secrets
# QDRANT_HOST and QDRANT_API_KEY with the same Cloud values.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false
PRIMARY_COLLECTION=bge_chunks
SECONDARY_COLLECTION=minilm_chunks

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis Cloud / Upstash (leave empty for local Redis)
REDIS_PASSWORD=
EMBEDDING_CACHE_TTL=86400
QUERY_CACHE_TTL=3600

# ── Embeddings ───────────────────────────────────────────
PRIMARY_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SECONDARY_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── Chunking ─────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=102

# ── Retrieval ────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
RRF_K_CONSTANT=60
MMR_LAMBDA=0.7

# ── App ──────────────────────────────────────────────────
LOG_LEVEL=INFO
